# Copiez ce fichier en .env.local pour le développement, et renseignez les
# mêmes variables dans Vercel → Project Settings → Environment Variables
# pour la production.

# --- Base de données (articles du blog, comptes admin, journal d'activité,
# soumissions de formulaires) ---
# Sur Vercel : onglet "Storage" du projet → "Create Database" → Postgres
# (compatible Neon, Supabase ou tout Postgres standard). La variable est
# injectée automatiquement dans le projet une fois la base connectée ; pour
# tester en local, copiez la connection string affichée dans le dashboard
# du fournisseur ici.
# IMPORTANT (10/09/2026) : vérifiez QUELLE base ce fournisseur pointe avant
# toute opération — développement ou production ? Voir docs/MIGRATIONS_DB.md
# et docs/SECURITE_FORMULAIRES.md §1. La création/mise à jour du schéma n'est
# JAMAIS automatique : voir `npm run db:migrate`.
DATABASE_URL=

# --- Stockage des photos uploadées depuis l'admin ---
# Sur Vercel : onglet "Storage" du projet → "Create Database" → Blob.
# Le token est injecté automatiquement en production ; copiez-le ici pour
# tester l'upload d'images en local.
BLOB_READ_WRITE_TOKEN=

# --- Secret de session admin ---
# Générez-le avec : openssl rand -base64 32
SESSION_SECRET=

# --- Génération d'articles par IA (bouton "Générer avec l'IA" dans l'admin) ---
# Clé API OpenAI (platform.openai.com → API keys). Optionnel : sans cette
# variable, le bouton IA affiche juste une erreur, le reste de l'admin
# fonctionne normalement.
OPENAI_API_KEY=

# --- Optionnel : URL publique du site, utilisée pour robots.txt/sitemap.xml ---
NEXT_PUBLIC_SITE_URL=https://www.2fpub.fr
